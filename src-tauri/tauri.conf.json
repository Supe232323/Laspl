{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laspl",
  "version": "1.0.5",
  "identifier": "com.laspl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Laspl",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true, 
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4RUZDOUFFOTUwRTBERDgKUldUWURRNlZyc252YUo3YStNeC9yMlgrNzB6bzY1ZmI4MjFZYXVMSVFxcHY0aWFHOTV2QmtJSzMK==",
      "endpoints": [
        "https://github.com"
      ]
    }
  }
}
